<script setup lang="ts">
import {ref} from 'vue'
import type {Fit} from '../types'
import {fmt} from '../api'
import Chart from '../components/Chart.vue'
import {qualityLabels,residualLabels,identificationGuide,trajectoryOption,residualOption,acfOption} from './diagnostics'
defineProps<{fit:Fit}>()
const detail=ref(false)
const warnings:Record<string,string>={rank_deficient:'Jacobiano a rango ridotto',ill_conditioned:'Jacobiano mal condizionato',at_bounds:'Parametri al bound',near_bounds:'Parametri vicini ai bounds',optimizer_not_converged:'Ottimizzatore non convergente',constant_power:'Potenza costante: manca eccitazione',autocorrelated_residuals:'Residui fortemente autocorrelati',recording_gaps:'Gap di registrazione: input mantenuto costante nel gap',irregular_sampling:'Campionamento irregolare',equivalent_predictions_different_parameters:'Predizioni equivalenti con parametri differenti',multistart_disagreement:'Gli start non concordano sui parametri'}
</script>
<template>
  <p v-if="fit.status!=='fitted'" class="message error">Fit fallito: {{fit.error}}</p>
  <template v-if="fit.metrics">
    <section class="diagnostic-section"><h3>Qualità della traiettoria</h3>
      <div class="fit-metrics"><div v-for="(label,key) in qualityLabels" :key="key"><small>{{label}}</small><strong>{{fmt(fit.metrics[key],3)}}</strong></div></div>
      <p v-if="fit.pre_window" class="note">Pre-window: {{fit.pre_window.available?`${fit.pre_window.samples} campioni, ${fit.pre_window.used?(fit.initialization_mode==='estimated_equilibrium'?'usata per P₀':'usata per P₀ e HR₀'):'solo contesto'}`:'assente'}}. <template v-if="fit.initial_conditions">P₀ = {{fmt(fit.initial_conditions.P0)}} W · HR₀ = {{fmt(fit.initial_conditions.HR0)}} bpm.</template></p>
      <p v-if="fit.initialization_mode==='estimated_equilibrium'" class="note">HR(0) osservata fissata; B = {{fmt(fit.initial_conditions?.B)}} bpm stimato; x(0) = {{fmt(fit.initial_conditions?.x0)}} bpm. Potenza precedente assunta costante a P₀.</p>
      <p v-if="fit.pre_window?.included_in_objective" class="note warning">Replay storico: campioni negativi inclusi nell’obiettivo originale; asse temporale riferito al primo record.</p>
      <Chart v-if="fit.series" :option="trajectoryOption(fit)" :group="fit.segment_id" :height="310"/>
    </section>
    <section class="diagnostic-section"><h3>Residui</h3>
      <div class="fit-metrics"><div v-for="(label,key) in residualLabels" :key="key"><small>{{label}}</small><strong>{{fmt(fit.metrics[key],3)}}</strong></div></div>
      <Chart v-if="fit.series" :option="residualOption(fit)" :group="fit.segment_id" :height="220"/>
      <details><summary>Autocorrelazione · lag in campioni</summary><Chart v-if="fit.residual_acf" :option="acfOption(fit)" :height="220"/><p v-else class="note">ACF completa non disponibile nella run storica.</p></details>
      <div class="fit-flags"><span v-for="w in fit.warnings" :key="w" class="tag warn">{{warnings[w]||w}}</span><span v-if="!fit.warnings?.length" class="tag">Nessuna segnalazione automatica</span></div>
    </section>
    <section class="diagnostic-section"><h3>Precisione dei parametri</h3>
      <div class="table-scroll"><table><thead><tr><th>Parametro</th><th>Stima</th><th>SE</th><th>CI95</th><th>RSE %</th><th>Bound hit</th><th>Near bound</th></tr></thead><tbody><tr v-for="(p,key) in fit.parameters" :key="key"><td><b>{{key}}</b> <small>{{key==='B'?'bpm':key==='K'?'bpm/W':key==='gamma'?'bpm/(W·s)':'s'}}</small><span v-if="p.fixed" class="tag">fissato</span></td><td>{{fmt(p.estimate,5)}}</td><td>{{fmt(p.se,5)}}</td><td>{{p.ci95?`${fmt(p.ci95[0],5)} — ${fmt(p.ci95[1],5)}`:'n.d.'}}</td><td>{{fmt(p.rse_pct,2)}}</td><td>{{p.at_bound?'sì':'no'}}</td><td>{{p.near_bound===undefined?'n.d.':p.near_bound?'sì':'no'}}</td></tr></tbody></table></div>
    </section>
    <section class="diagnostic-section"><h3>Identificabilità</h3>
      <details><summary>Guida rapida alla lettura</summary><ul class="note"><li v-for="line in identificationGuide" :key="line">{{line}}</li></ul></details>
      <div class="fit-metrics"><div><small>ρ</small><strong>{{fit.model_structure==='short_transient'?'non applicabile':fmt(fit.rho,3)}}</strong></div><div><small>correlation_K_tau</small><strong>{{fit.model_structure==='short_transient'?'non applicabile':fmt(fit.identifiability?.correlation_K_tau,3)}}</strong></div><div><small>Rango Jacobiano</small><strong>{{fit.uncertainty.rank}} / {{fit.uncertainty.p??Object.keys(fit.parameters).length}}</strong></div><div><small>Condizionamento</small><strong>{{fmt(fit.uncertainty.jacobian_condition)}}</strong></div></div>
      <p class="note">Correlazioni: <span v-for="(value,key) in fit.identifiability?.correlations" :key="key">{{key}} = {{fmt(value,3)}}; </span><span v-if="!fit.identifiability">non disponibili nella run storica</span></p>
      <p v-if="fit.search?.strategy==='profile_multistart'" class="note">Ricerca: {{fit.search.grid_evaluations}} coppie L, ?. SSE multistart originale: {{fmt(fit.search.baseline_SSE,3)}}; selezione: {{fit.search.selected_source}}.</p>
      <p class="note">Accordo multistart: {{fit.all_starts_agree?'sì':'no'}}.</p>
    </section>
  </template>
  <button class="text-button" @click="detail=!detail">{{detail?'Nascondi':'Mostra'}} diagnostiche complete</button>
  <pre v-if="detail">{{JSON.stringify({...fit,series:undefined},null,2)}}</pre>
</template>
