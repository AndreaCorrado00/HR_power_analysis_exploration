<script setup lang="ts">
import {computed,ref,watch} from 'vue'
import {api,fmt,date,statusLabel} from '../api'
import type {Dataset,Model,Run,Config} from '../types'
const props=defineProps<{datasets:Dataset[];selected:string;models:Model[];runs:Run[];busy:boolean;act:(f:()=>Promise<unknown>,message?:string)=>Promise<void>}>()
const emit=defineEmits<{select:[id:string];open:[id:string]}>()
const modelId=ref('p1d'),signal=ref('raw'),config=ref<Config>({lower:[1e-6,0,.01],upper:[5,null,1800],n_starts:8,seed:42,max_nfev:500})
const archives=ref<Run[]>([]),showArchives=ref(false),deleteId=ref(''),expanded=ref('')
const ds=computed(()=>props.datasets.find(d=>d.id===props.selected)),model=computed(()=>props.models.find(m=>m.id===modelId.value))
const structureId=ref('p1d_full')
const structures=computed(()=>model.value?.structures||[{id:'p1d_full',name:'P1D full',parameters:model.value?.parameters||[],default_config:model.value?.default_config||config.value}])
const structure=computed(()=>structures.value.find(s=>s.id===structureId.value)||structures.value[0])
const estimated=computed(()=>config.value.initialization_mode==='estimated_equilibrium')
const bBounds=ref<(number|string|null)[]>([null,null])
const validB=computed(()=>!estimated.value||(bBounds.value.every(v=>typeof v==='number'&&Number.isFinite(v))&&Number(bBounds.value[0])<Number(bBounds.value[1])))
watch(model,()=>{if(model.value){structureId.value='p1d_full';config.value={...JSON.parse(JSON.stringify(model.value.default_config)),model_structure:'p1d_full'};bBounds.value=(config.value.equilibrium_bounds as (number|null)[])||[null,null]}}, {immediate:true})
watch(structureId,()=>{const use=config.value.use_pre_window;config.value={...JSON.parse(JSON.stringify(structure.value.default_config)),model_structure:structureId.value,use_pre_window:use}})
const train=computed(()=>ds.value?.segments.filter(s=>ds.value?.split?.assignments.train.includes(s.id))||[])
const hasMA=computed(()=>train.value.length>0&&train.value.every(s=>s.signals.includes('ma')))
watch(hasMA,()=>{if(!hasMA.value)signal.value='raw'})
function launch(){if(!validB.value)return;if(config.value.upper[1] === '')config.value.upper[1]=null;if(estimated.value)config.value.equilibrium_bounds=[...bBounds.value];props.act(async()=>{await api('/runs','POST',{dataset_id:props.selected,model_id:modelId.value,signal:signal.value,config:config.value})},'Run avviata. Manifest e impostazioni salvati prima del fit.')}
function loadArchives(){showArchives.value=!showArchives.value;if(showArchives.value)props.act(async()=>{archives.value=await api('/archives')},'')}
function remove(id:string){props.act(async()=>{await api('/runs/'+id,'DELETE');deleteId.value='';archives.value=await api('/archives')},'Risultati eliminati; il manifest è conservato in archivio.')}
</script>

<template>
  <div class="two-columns run-columns"><section class="card"><div class="card-heading"><span class="step">01</span><div><h2>Configura la run</h2><p>Parametri e vincoli espliciti, prima di partire</p></div></div>
    <label>Dataset<select :value="selected" @change="emit('select',($event.target as HTMLSelectElement).value)"><option value="" disabled>Seleziona un dataset</option><option v-for="d in datasets" :key="d.id" :value="d.id">{{d.name}}</option></select></label>
    <label>Modello<select v-model="modelId"><option v-for="m in models" :key="m.id" :value="m.id">{{m.name}}</option></select></label>
    <label>Struttura del modello<select v-model="structureId" aria-label="Struttura del modello"><option v-for="s in structures" :key="s.id" :value="s.id">{{s.name}}</option></select></label>
    <label v-if="structureId==='p1d_full'">Inizializzazione<select v-model="config.initialization_mode" aria-label="Inizializzazione"><option value="equilibrium">Equilibrio iniziale assunto · attuale</option><option value="estimated_equilibrium">HR(0) osservata · equilibrio B stimato</option></select></label>
    <label class="check"><input type="checkbox" v-model="config.use_pre_window" aria-label="Usa pre-window">Usa pre-window di 10 s per {{estimated?'P₀':'P₀ e HR₀'}}</label>
    <p class="note">Campioni con −10 ≤ t &lt; 0, esclusi dal fit. Se richiesta ma assente o non valida, il segmento fallisce con motivazione; la disponibilità viene registrata nel manifest.</p>
    <label>Segnali in ingresso al fit<select v-model="signal"><option value="raw">Originali · power_w / heart_rate_bpm</option><option value="ma" :disabled="!hasMA">Medie mobili · power_ma_w / heart_rate_ma_bpm</option></select></label>
    <p class="note">Nessun filtro aggiuntivo. Le medie mobili sono disponibili solo se presenti nei CSV train.</p>
    <h3>Bounds dei parametri</h3><div class="bound-head"><span>Parametro</span><span>Minimo</span><span>Massimo</span></div><div v-for="(p,i) in structure.parameters" :key="p.key" class="bound-row"><label>{{p.key}} <small>{{p.unit}}</small></label><input :aria-label="p.key+' minimo'" type="number" step="any" v-model.number="config.lower[i]" :disabled="p.key==='L'"><input :aria-label="p.key+' massimo'" type="number" step="any" v-model.number="config.upper[i]" :min="p.key==='L'?0:undefined" :placeholder="p.key==='L'?'T (automatico)':undefined"></div>
    <p class="note">L: 0 ≤ L ≤ T. Massimo vuoto = durata del segmento; un limite personalizzato viene ridotto a T se necessario.</p>
    <div v-if="estimated" class="bound-row"><label>B <small>bpm</small></label><input aria-label="B minimo" type="number" step="any" v-model.number="bBounds[0]" placeholder="Richiesto"><input aria-label="B massimo" type="number" step="any" v-model.number="bBounds[1]" placeholder="Richiesto"></div>
    <p v-if="!validB" class="note warning">Inserisci i limiti numerici di B: minimo e massimo finiti, con minimo &lt; massimo.</p>
    <div class="three-fields"><label>Inizializzazioni<input v-model.number="config.n_starts" type="number" min="2" max="64"></label><label>Seed del fit<input v-model.number="config.seed" type="number" min="0"></label><label>Max valutazioni<input v-model.number="config.max_nfev" type="number" min="10" max="10000"></label></div>
    <button class="primary full" :disabled="busy||!train.length||!validB" @click="launch">Avvia identificazione <span>→</span></button><p v-if="!train.length" class="note warning">Importa un dataset e salva il suo split per iniziare.</p>
  </section>
  <section class="card preview-card"><div class="eyebrow">ANTEPRIMA ESPERIMENTO</div><h2>{{ds?.name||'Scegli un dataset'}}</h2><div class="formula">{{structureId==='short_transient'?'dx/dt = γ [P(t−L) − P₀]':'τ dx/dt + x = K [P(t−L) − P₀]'}}</div><div class="stats-grid"><div><small>FIT DA ESEGUIRE</small><strong>{{train.length}}</strong></div><div><small>PARAMETRI / SEGMENTO</small><strong>{{structure.parameters.length+(estimated?1:0)}}</strong></div></div>
    <dl class="properties"><div><dt>Modello</dt><dd>{{model?.id.toUpperCase()}} · {{model?.version}}</dd></div><div><dt>Split</dt><dd>{{ds?.split?.percentages.join(' / ')||'Non configurato'}} %</dd></div><div><dt>Unità / seed split</dt><dd>{{ds?.split?.unit||'—'}} / {{ds?.split?.seed??'—'}}</dd></div><div><dt>Ottimizzatore</dt><dd>TRF · SSE · {{structureId==='p1d_full'?'griglia + multistart':'multistart'}}</dd></div><div><dt>Incertezza</dt><dd>Jacobiano · CI 95% approssimati</dd></div><div><dt>Validazione / test</dt><dd>Riservati, non utilizzati</dd></div></dl>
    <div v-if="estimated" class="assumption"><strong>Equilibrio B stimato</strong><p>HR prevista(0) = HR osservata(0); x(0) = HR(0) - B. {{config.use_pre_window?'P0 = mean(Ppre).':'P0 = P(0).'}} Prima del segmento, potenza costante a P0. B viene stimato, senza interpretazione fisiologica.</p></div><div v-else class="assumption"><strong>Equilibrio iniziale assunto</strong><p>{{config.use_pre_window?'P₀ = mean(Ppre), HR₀ = mean(HRpre).':'P₀ = P(0), HR₀ = HR(0).'}} x(0) = 0. Prima del segmento, potenza costante a P₀. I riferimenti non vengono stimati.</p></div><p class="note">Bounds numerici, non limiti fisiologici. I fit descrivono i segmenti train; non misurano la capacità predittiva fuori campione.</p>
  </section></div>
  <section class="card"><div class="section-heading"><div><h2>Registro degli esperimenti <span class="count">{{runs.length}}</span></h2><p>Impostazioni e risultati persistono dopo il riavvio.</p></div><button class="secondary" @click="loadArchives">{{showArchives?'Nascondi archivio':'Manifest archiviati'}}</button></div>
    <div v-if="!runs.length" class="empty compact"><h3>Nessuna run, per ora</h3><p>Il primo esperimento comparirà qui con il suo avanzamento.</p></div>
    <div class="run-list"><article v-for="run in [...runs].reverse()" :key="run.id" class="run-row"><div class="run-main"><div><span class="badge" :class="run.status">{{statusLabel(run.status)}}</span><small>{{date(run.created_at)}}</small></div><h3>{{run.dataset.name}} <span>· {{run.model.id.toUpperCase()}}</span></h3><p>{{run.progress.done}} / {{run.progress.total}} segmenti · {{run.config.n_starts}} start · seed {{run.config.seed}} <span v-if="run.progress.failed">· {{run.progress.failed}} errori</span></p><progress v-if="['running','queued'].includes(run.status)" :value="run.progress.done" :max="run.progress.total"></progress><p v-if="run.error" class="warning">{{run.error}}</p></div><div class="run-actions"><button class="secondary" @click="emit('open',run.id)">Apri analisi ↗</button><button class="text-button" @click="expanded=expanded===run.id?'':run.id">Impostazioni</button><button class="text-button danger" :disabled="busy||['running','queued'].includes(run.status)" @click="deleteId=run.id">Elimina</button></div><div v-if="expanded===run.id" class="run-detail"><a :href="`/api/runs/${run.id}/manifest`" class="text-button">↓ Scarica manifest</a><button class="text-button" :disabled="busy" @click="act(()=>api(`/runs/${run.id}/replay`,'POST'),'Nuova run creata con dataset e split originali')">Ripeti impostazioni</button><pre>{{JSON.stringify({manifest:run.manifest_filename,columns:run.columns,split:{unit:run.split.unit,seed:run.split.seed,percentages:run.split.percentages},config:run.config,initial_conditions:run.model.initial_conditions,code:run.environment.code_sha256},null,2)}}</pre></div></article></div>
    <div v-if="showArchives"><h3>Archivio · solo manifest</h3><p class="note">I risultati sono stati eliminati. Puoi scaricare le impostazioni o rieseguire l’esperimento usando i CSV conservati.</p><p v-if="!archives.length" class="muted">Nessun manifest archiviato.</p><div v-for="run in archives" :key="run.id" class="archive-row"><span>{{run.dataset.name}} · {{date(run.created_at)}}</span><a :href="`/api/archives/${run.id}/manifest`">Manifest ↓</a><button class="secondary" :disabled="busy" @click="act(()=>api(`/archives/${run.id}/replay`,'POST'),'Esperimento ricreato dall’archivio')">Riesegui</button></div></div>
  </section>
  <div v-if="deleteId" class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-title"><h2 id="delete-title">Eliminare i risultati della run?</h2><p>Il manifest verrà archiviato. I CSV importati restano disponibili per ripetere l’esperimento.</p><div class="inline"><button class="secondary" @click="deleteId=''">Annulla</button><button class="danger-button" :disabled="busy" @click="remove(deleteId)">Elimina e archivia manifest</button></div></section></div>
</template>
