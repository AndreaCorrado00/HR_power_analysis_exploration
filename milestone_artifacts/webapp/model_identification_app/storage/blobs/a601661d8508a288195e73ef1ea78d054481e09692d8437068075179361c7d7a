"""Separate observed pre-transition context from objective samples, without resampling."""
import numpy as np


def pre_window(t, power, hr):
    t, power, hr = (np.asarray(v, float) for v in (t, power, hr))
    mask = (t >= -10) & (t < 0)
    finite = bool(np.isfinite(power[mask]).all() and np.isfinite(hr[mask]).all())
    def clean(values):
        return [float(v) if np.isfinite(v) else None for v in values]
    return {'available': bool(mask.any()), 'used': False, 'seconds': 10,
            'samples': int(mask.sum()), 'signals_finite': finite,
            'time': clean(t[mask]), 'power': clean(power[mask]), 'observed': clean(hr[mask]),
            'first_time': float(t[mask][0]) if mask.any() else None,
            'last_time': float(t[mask][-1]) if mask.any() else None}


def prepare(t, power, hr, use_pre_window=False, protocol='segment_v2'):
    t, power, hr = (np.asarray(v, float) for v in (t, power, hr))
    if t.ndim != 1 or not len(t) or power.shape != t.shape or hr.shape != t.shape:
        raise ValueError('Dimensioni dei segnali non coerenti')
    if not np.isfinite(t).all() or np.any(np.diff(t) <= 0):
        raise ValueError('Tempi non strettamente crescenti o non finiti')
    pre = pre_window(t, power, hr)
    pre['included_in_objective'] = protocol == 'legacy_v1'
    if use_pre_window and not pre['available']:
        raise ValueError('pre_window_absent')
    if use_pre_window and not pre['signals_finite']:
        raise ValueError('pre_window_nonfinite')
    if protocol != 'legacy_v1':
        mask = t >= 0
        if np.any(t < 0) and (not mask.any() or t[mask][0] != 0):
            raise ValueError('lap_start_missing: richiesto campione t=0')
        t, power, hr = t[mask], power[mask], hr[mask]
    if len(t) < 4 or not np.isfinite([t, power, hr]).all():
        raise ValueError('Servono almeno 4 osservazioni finite nel segmento')
    p0 = float(np.mean(pre['power'])) if use_pre_window else float(power[0])
    hr0 = float(np.mean(pre['observed'])) if use_pre_window else float(hr[0])
    pre['used'] = use_pre_window
    return t-t[0], power, hr, p0, hr0, pre
